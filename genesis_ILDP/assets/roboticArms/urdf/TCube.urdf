<?xml version="1.0"?>
<robot name="TCube">

<link name="world"/>

<material name="bb">
    <color rgba="0 0 1 1"/>
</material>

<link name="cubeHL">
    <visual>
        <geometry>
            <box size="0.06 0.1 0.1"/>
        </geometry>
        <material name="bb"/>
    </visual>
    <collision>
        <geometry>
            <box size="0.06 0.1 0.1"/>
        </geometry>
    </collision>
    <inertial>
        <mass value="0.2"/>
        <inertia ixx="0.00035" ixy="0" ixz="0" iyy="0.00035" iyz="0" izz="0.00035"/>
    </inertial>
</link>

<link name="cubeHR">
    <visual>
        <geometry>
            <box size="0.06 0.1 0.1"/>
        </geometry>
        <material name="bb"/>
    </visual>
    <collision>
        <geometry>
            <box size="0.06 0.1 0.1"/>
        </geometry>
    </collision>
    <inertial>
        <mass value="0.2"/>
        <inertia ixx="0.00035" ixy="0" ixz="0" iyy="0.00035" iyz="0" izz="0.00035"/>
    </inertial>
</link>

<link name="cubeV1">
    <visual>
        <geometry>
            <box size="0.1 0.06 0.1"/>
        </geometry>
        <material name="bb"/>
    </visual>
    <collision>
        <geometry>
            <box size="0.1 0.06 0.1"/>
        </geometry>
    </collision>
    <inertial>
        <mass value="0.2"/>
        <inertia ixx="0.00035" ixy="0" ixz="0" iyy="0.00035" iyz="0" izz="0.00035"/>
    </inertial>
</link>

<link name="cubeV2">
    <visual>
        <geometry>
            <box size="0.1 0.06 0.1"/>
        </geometry>
        <material name="bb"/>
    </visual>
    <collision>
        <geometry>
            <box size="0.1 0.06 0.1"/>
        </geometry>
    </collision>
    <inertial>
        <mass value="0.2"/>
        <inertia ixx="0.00035" ixy="0" ixz="0" iyy="0.00035" iyz="0" izz="0.00035"/>
    </inertial>
</link>

<link name="center"/>

<joint name="cube_plane_joint" type="floating">
    <parent link="world"/>
    <child link="center"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
</joint>


<joint name="Horizontal_joint_left" type="fixed">
    <parent link="center"/>
    <child link="cubeHL"/>
    <origin xyz="0 -0.05 0" rpy="0 0 0"/>
</joint>

<joint name="Horizontal_joint_right" type="fixed">
    <parent link="center"/>
    <child link="cubeHR"/>
    <origin xyz="0 0.05 0" rpy="0 0 0"/>
</joint>

<joint name="Horizontal_joint_bottom1" type="fixed">
    <parent link="center"/>
    <child link="cubeV1"/>
    <origin xyz="-0.08 0 0" rpy="0 0 0"/>
</joint>

<joint name="Horizontal_joint_bottom2" type="fixed">
    <parent link="cubeV1"/>
    <child link="cubeV2"/>
    <origin xyz="-0.1 0 0" rpy="0 0 0"/>
</joint>

</robot>
