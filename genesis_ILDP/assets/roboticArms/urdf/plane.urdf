<?xml version="1.0"?>
<robot name="plane_with_Tcube_marker">

<material name="red">
    <color rgba="1 0 0 1"/>
</material>

<link name="world"/>
<link name="plane">
    <visual>
        <geometry>
            <box size="200 200 10"/>
        </geometry>
        <material name="gray">
            <color rgba="0.9 0.9 0.9 1"/>
        </material>
    </visual>
    <collision>
        <geometry>
            <box size="200 200 10"/>
        </geometry>
    </collision>
    <inertial>
        <mass value="10000"/>
        <inertia ixx="1" ixy="0" ixz="0" iyy="1" iyz="0" izz="1"/>
    </inertial>
</link>

<!-- <link name="marker">
    <visual>
        <geometry>
            <box size="0.11 0.11 0.001"/>
        </geometry>
        <material name="red">
            <color rgba="1 0 0 1"/>
        </material>
    </visual>
    <inertial>
        <mass value="100"/>
        <inertia ixx="0.00035" ixy="0" ixz="0" iyy="0.00035" iyz="0" izz="0.00035"/>
    </inertial>
</link> -->


<joint name="plane_joint" type="fixed">
    <parent link="world"/>
    <child link="plane"/>
    <origin xyz="0 0.0 -5.0" rpy="0 0 0"/>
</joint>

<!-- <joint name="marker_joint" type="floating">
    <parent link="world"/>
    <child link="marker"/>
    <origin xyz="0.5 0.5 0.04" rpy="0 0 0"/>
    <limit lower="-3.1415926" upper="3.1415926"/> 
</joint> -->
<link name="cubeHL">
    <visual>
        <geometry>
            <box size="0.06 0.1 0.001"/>
        </geometry>
        <material name="red"/>
    </visual>
    <inertial>
        <mass value="0.2"/>
        <inertia ixx="0.00035" ixy="0" ixz="0" iyy="0.00035" iyz="0" izz="0.00035"/>
    </inertial>
</link>

<link name="cubeHR">
    <visual>
        <geometry>
            <box size="0.06 0.1 0.001"/>
        </geometry>
        <material name="red"/>
    </visual>
    <inertial>
        <mass value="0.2"/>
        <inertia ixx="0.00035" ixy="0" ixz="0" iyy="0.00035" iyz="0" izz="0.00035"/>
    </inertial>
</link>

<link name="cubeV1">
    <visual>
        <geometry>
            <box size="0.1 0.06 0.001"/>
        </geometry>
        <material name="red"/>
    </visual>
    <inertial>
        <mass value="0.2"/>
        <inertia ixx="0.00035" ixy="0" ixz="0" iyy="0.00035" iyz="0" izz="0.00035"/>
    </inertial>
</link>

<link name="cubeV2">
    <visual>
        <geometry>
            <box size="0.1 0.06 0.001"/>
        </geometry>
        <material name="red"/>
    </visual>
    <inertial>
        <mass value="0.2"/>
        <inertia ixx="0.00035" ixy="0" ixz="0" iyy="0.00035" iyz="0" izz="0.00035"/>
    </inertial>
</link>

<link name="marker"/>

<joint name="marker_joint" type="floating">
    <parent link="world"/>
    <child link="marker"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
</joint>

<joint name="Horizontal_joint_left" type="fixed">
    <parent link="marker"/>
    <child link="cubeHL"/>
    <origin xyz="0 -0.05 0" rpy="0 0 0"/>
</joint>

<joint name="Horizontal_joint_right" type="fixed">
    <parent link="marker"/>
    <child link="cubeHR"/>
    <origin xyz="0 0.05 0" rpy="0 0 0"/>
</joint>

<joint name="Horizontal_joint_bottom1" type="fixed">
    <parent link="marker"/>
    <child link="cubeV1"/>
    <origin xyz="-0.08 0 0" rpy="0 0 0"/>
</joint>

<joint name="Horizontal_joint_bottom2" type="fixed">
    <parent link="cubeV1"/>
    <child link="cubeV2"/>
    <origin xyz="-0.1 0 0" rpy="0 0 0"/>
</joint>

</robot>